# OrderForge environment: names only, placeholder values. Copy to .env.local / .env and fill in.
# Never commit real values. PAYPAL_ENV must stay "sandbox".

SANDBOX_MODE=true
APP_BASE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Hosted migrations only (`supabase db push --db-url ...`). Use the SESSION POOLER string (the direct host is IPv6-only).
# Never upload this one to Vercel.
# SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# PayPal (sandbox only)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-sandbox-webhook-id

# AI
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional: intake models. Primary must be a free (:free) model; the fallback is a low-cost paid model used only after a provider failure.
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_FALLBACK_MODEL=openai/gpt-oss-120b
# Local development only (refused with a hosted database or on Vercel): a rule-based stand-in instead of a real model.
# INTAKE_MODEL=local-demo

# App secrets (generate long random strings)
ACCESS_LINK_SECRET=replace-with-long-random-string
CRON_SECRET=replace-with-long-random-string

# Demo merchant login for the seed script (test credential for this sandbox app only)
DEMO_MERCHANT_EMAIL=merchant@demo.test
DEMO_MERCHANT_PASSWORD=replace-with-demo-merchant-password
# The second demo shop (Demo Event Kits) has its own owner, so one shop's owner cannot see the other's data. Must differ from the first.
DEMO_MERCHANT2_EMAIL=merchant2@demo.test
DEMO_MERCHANT2_PASSWORD=replace-with-demo-merchant-two-password

# Optional: point the PayPal spike at a LOCAL fake instead of the sandbox (see `npm run paypal:fake`).
# Only http://127.0.0.1 or http://localhost is accepted. Leave unset to use the real PayPal sandbox.
# PAYPAL_SPIKE_BASE_URL=http://127.0.0.1:4010

# Optional: the PayPal merchant id that must receive each capture. When set, a capture paid to anyone else is a financial exception.
# PAYPAL_PAYEE_MERCHANT_ID=

# Optional: email through Resend (https://resend.com). Sending is OFF unless both RESEND_API_KEY and EMAIL_FROM are set; empty counts as unset.
# Tests and CI never send: the real provider is not built there even if these are set. Until a domain is verified in Resend, EMAIL_FROM can be
# onboarding@resend.dev, which can only deliver to the address of the Resend account owner. Never commit a real key.
# RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_REPLY_TO=
